{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitrex-cch-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monitrex-cch-relay"
    }
  ]
}
